<div class="layout bng bng-half-v"><div class="bng-shell">
  <header class="bng-header"><div class="bng-brand"><div class="bng-bird-mark">{% render "bird_icon" %}</div><div><div class="bng-title">{{ station }}</div><div class="bng-subtitle">BirdNET-Go · {{ date_label }}</div></div></div></header>
  <section class="bng-panel bng-portrait">{% if featured.image_url != blank %}<img src="{{ featured.image_url }}" alt="{{ featured.name }}">{% else %}<div class="bng-portrait-empty">{% render "bird_icon" %}</div>{% endif %}</section>
  <section class="bng-feature"><div class="bng-feature-name">{{ featured.name }}</div><div class="bng-feature-scientific">{{ featured.scientific }}</div>{% if featured.heard != blank %}<div class="bng-feature-meta"><span class="bng-pill">{{ featured.heard }}</span><span class="bng-pill">{{ featured.confidence }}%</span></div>{% endif %}<div class="bng-metrics"><div class="bng-metric"><div class="bng-metric-label">Detections</div><div class="bng-metric-value">{{ detections }}</div></div><div class="bng-metric"><div class="bng-metric-label">Species</div><div class="bng-metric-value">{{ species }}</div></div></div></section>
  <section class="bng-panel bng-top"><div class="bng-panel-title">Top species today</div>{% if top_species.size > 0 %}<table class="bng-table"><thead><tr><th class="bng-rank">#</th><th>Species</th><th class="bng-count">Calls</th></tr></thead><tbody>{% for bird in top_species limit: 3 %}<tr><td class="bng-rank">{{ forloop.index }}</td><td class="bng-species-name">{{ bird.name }}</td><td class="bng-count">{{ bird.count }}</td></tr>{% endfor %}</tbody></table>{% else %}<div class="bng-empty">Listening for the first bird of the day.</div>{% endif %}</section>
  <footer class="bng-footer"><span>Acoustic detections</span><span>Checked {{ checked_at }}</span></footer>
</div></div>
