<div class="layout bng bng-quad"><div class="bng-shell">
  <header class="bng-header"><div class="bng-brand"><div class="bng-bird-mark">{% render "bird_icon" %}</div><div><div class="bng-title">{{ station }}</div><div class="bng-subtitle">BirdNET-Go</div></div></div></header>
  <section class="bng-feature"><div class="bng-feature-name">{{ featured.name }}</div><div class="bng-feature-scientific">{{ featured.scientific }}</div>{% if featured.heard != blank %}<div class="bng-feature-meta"><span class="bng-pill">{{ featured.heard }}</span><span class="bng-pill">{{ featured.confidence }}%</span></div>{% endif %}<div class="bng-metrics"><div class="bng-metric"><div class="bng-metric-label">Detections</div><div class="bng-metric-value">{{ detections }}</div></div><div class="bng-metric"><div class="bng-metric-label">Species</div><div class="bng-metric-value">{{ species }}</div></div></div></section>
  <section class="bng-panel bng-top"><div class="bng-panel-title">Top today</div>{% if top_species.size > 0 %}<table class="bng-table"><tbody>{% for bird in top_species limit: 5 %}<tr><td class="bng-rank">{{ forloop.index }}</td><td class="bng-species-name">{{ bird.name }}</td><td class="bng-count">{{ bird.count }}</td></tr>{% endfor %}</tbody></table>{% else %}<div class="bng-empty">Listening…</div>{% endif %}</section>
  <footer class="bng-footer"><span>Acoustic detections</span><span>{{ checked_at }}</span></footer>
</div></div>
