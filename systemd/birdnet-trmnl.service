[Unit]
Description=Push BirdNET-Go daily summary to TRMNL
After=network-online.target birdnet-go.service
Wants=network-online.target

[Service]
Type=oneshot
DynamicUser=yes
EnvironmentFile=/etc/birdnet-trmnl.env
ExecStart=/usr/bin/python3 /usr/local/libexec/birdnet-trmnl
CacheDirectory=birdnet-trmnl
StateDirectory=birdnet-trmnl
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
TimeoutStartSec=45
