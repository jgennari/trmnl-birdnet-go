# Copy to /etc/birdnet-trmnl.env, keep mode 0600, and replace the webhook URL.
BIRDNET_TRMNL_BIRDNET_URL=http://127.0.0.1:8080
BIRDNET_TRMNL_WEBHOOK_URL=https://trmnl.com/api/custom_plugins/REPLACE_WITH_PLUGIN_UUID
BIRDNET_TRMNL_STATION_NAME="Backyard Birds"
BIRDNET_TRMNL_TIMEZONE=America/New_York
BIRDNET_TRMNL_WIKIMEDIA_IMAGES=true
BIRDNET_TRMNL_MAX_PAYLOAD_BYTES=2000
